# Copy to .env and fill in. Never commit .env.

BUSINESS_NAME=Georgia Solar Panels
PUBLIC_BASE_URL=https://your-app.example.com      # where Twilio/Calendly can reach this app
DB_PATH=./data/leads.db

# --- Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
AI_MODE=claude                                    # "fake" = no API calls (demo/testing)

# --- Sending
AUTO_SEND=false                                   # false = every reply waits in /admin for approval
BOOKING_LINK=https://calendly.com/your-link/15min
REMINDER_AFTER_HOURS=24

# --- Gmail (reads the inbox + Google Voice forwards, sends email)
GMAIL_ENABLED=false
GMAIL_CREDENTIALS_FILE=./secrets/credentials.json
GMAIL_TOKEN_FILE=./secrets/token.json
GMAIL_POLL_SECONDS=60
BUSINESS_EMAIL=info@yourdomain.com
NOTIFY_EMAILS=owner@yourdomain.com,jarod@yourdomain.com

# --- Texting: twilio | gvoice_email | log (practice: records texts, sends nothing) | none
SMS_PROVIDER=gvoice_email
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+14045550000

# --- Booking webhook
CALENDLY_SIGNING_KEY=

# --- /admin login
ADMIN_USER=admin
ADMIN_PASSWORD=
